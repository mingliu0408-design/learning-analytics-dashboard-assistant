            "step_id",
            "task_id",
            "kind",
            "action",
            "estimated_duration",
            "resource_ids",
            "dependencies",
            "schedule",
            "completion_check",
            "evidence_refs",
            "brief_rationale"
          ],
          "additionalProperties": false
        }
      },
      "evidence_refs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Exact IDs from the supplied reference_catalog. An ID identifies evidence; it does not prove semantic support."
      },
      "continues_plan_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Null unless an actually adopted active plan is supplied; a non-null value must be its exact ID."
      },
      "brief_rationale": {
        "type": "string"
      }
    },
    "required": [
      "plan_id",
      "goal_id",
      "goal",
      "actions",
      "evidence_refs",
      "continues_plan_id",
      "brief_rationale"
    ],
    "additionalProperties": false
  }
]
