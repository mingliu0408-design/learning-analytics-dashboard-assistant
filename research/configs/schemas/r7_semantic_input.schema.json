{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One externally supplied R7 semantic input row",
  "type": "object",
  "required": ["annotation_case_id", "current_query", "current_page", "dashboard_context", "visible_conversation_history"],
  "additionalProperties": false,
  "properties": {
    "annotation_case_id": {"type": "string", "minLength": 1},
    "current_query": {"type": "string", "minLength": 1},
    "current_page": {"enum": ["Overview", "Resources", "Lecture", "Debate", "Reflection", "Other"]},
    "dashboard_context": {"type": "string"},
    "visible_conversation_history": {"type": "array", "items": {"type": "object", "required": ["role", "content"], "additionalProperties": false, "properties": {"role": {"enum": ["user", "assistant"]}, "content": {"type": "string", "minLength": 1}}}}
  }
}
