  "additionalProperties": false,
  "properties": {
    "annotation_case_id": {
      "type": "string"
    },
    "attempt_records": {
      "maxItems": 2,
      "minItems": 1,
      "type": "array"
    },
    "execution_status": {
      "enum": [
        "VALID_PREDICTION",
        "INVALID_TERMINAL_RESULT",
        "PROVIDER_ERROR"
      ]
    },
    "logical_call_id": {
      "type": "string"
    },
    "logical_case_id": {
      "type": "string"
    },
