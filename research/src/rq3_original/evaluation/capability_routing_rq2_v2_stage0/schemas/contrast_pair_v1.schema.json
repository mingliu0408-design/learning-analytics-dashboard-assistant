{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dute.local/schemas/rq2-v2-contrast-pair-v1.schema.json",
  "title": "RQ2-V2 controlled contrast pair",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contrast_id", "case_a_id", "case_b_id", "expected_changed_labels"],
  "properties": {
    "schema_version": {"const": "rq2-v2-contrast-pair-v1"},
    "contrast_id": {"type": "string", "minLength": 1},
    "case_a_id": {"type": "string", "minLength": 1},
    "case_b_id": {"type": "string", "minLength": 1},
    "expected_changed_labels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["rag_required", "memory_required", "planning_required"]}
    }
  }
}

